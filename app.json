{
  "expo": {
    "name": "Papilles - Recettes de Cuisine",
    "slug": "papilles-recettes",
    "version": "1.0.0",
    "scheme": "papilles",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andimi0n.papilles",
      "infoPlist": {
        "NSCameraUsageDescription": "Papilles utilise la caméra pour scanner des recettes imprimées et des QR codes de partage."
      }
    },
    "android": {
      "package": "com.andimi0n.papilles",
      "adaptiveIcon": {
        "backgroundColor": "#1B3D2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B3D2C"
        }
      ],
      "expo-sharing",
      "expo-image"
    ]
  }
}
