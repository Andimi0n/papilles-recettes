{
  "expo": {
    "name": "Papilles",
    "slug": "papilles-recettes",
    "version": "1.0.0",
    "scheme": "papilles",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andimi0n.papilles",
      "infoPlist": {
        "NSCameraUsageDescription": "Papilles utilise la caméra pour photographier vos recettes, scanner des fiches imprimées et lire les QR codes de partage.",
        "NSPhotoLibraryUsageDescription": "Papilles utilise vos photos pour importer des images de recettes depuis votre galerie."
      }
    },
    "android": {
      "package": "com.andimi0n.papilles",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#1B3D2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "hidden": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Ionicons.ttf"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B3D2C"
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Papilles utilise vos photos pour importer des images de recettes depuis votre galerie.",
          "cameraPermission": "Papilles utilise votre appareil photo pour photographier vos recettes et scanner vos fiches."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B3D2C"
        }
      ],
      "./plugins/withLargeHeap"
    ],
    "extra": {
      "eas": {
        "projectId": "84b3acf3-9d09-4c23-92e4-18152ddc9df8"
      }
    },
    "owner": "andimion"
  }
}
