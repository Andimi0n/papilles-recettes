{
  "name": "papilles-recettes",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.20",
    "expo-camera": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-print": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "lz-string": "^1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-swipe-list-view": "^4.0.0",
    "react-native-web": "^0.21.4",
    "toqr": "^0.1.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/lz-string": "^1.3.34",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I | awk '{print $1}') expo start --lan -c",
    "lan": "EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I | awk '{print $1}') expo start --lan",
    "tunnel": "EXPO_NO_TELEMETRY=1 expo start --tunnel",
    "lan:wifi": "EXPO_NO_TELEMETRY=1 expo start --lan",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "import:marmiton": "node scripts/import_marmiton.js",
    "normalize:seed": "node scripts/normalizeInitialRecipes.js",
    "validate:lexicon": "node scripts/validateCanonicalVocabulary.js",
    "test:stock": "node scripts/testStockMatcher.js",
    "test:shopping": "node scripts/testShoppingAggregator.js",
    "test:allergens": "node scripts/testAllergenMatcher.js",
    "test:cascade": "node scripts/testVocabularyCascade.js",
    "test:unified-input": "node scripts/testUnifiedIngredientSystem.js",
    "test:recipe-links": "node scripts/testRecipeLinkMatcher.js",
    "test:unit-converter": "node scripts/testUnitConverter.js",
    "test:tags": "node scripts/testTagSystem.js",
    "test:share": "node scripts/testRecipeShareService.js",
    "test:pdf": "node scripts/testRecipePdfService.js",
    "test:web-recipe": "node scripts/testWebRecipeService.js",
    "test:search": "node scripts/testIngredientSearchMatcher.js",
    "test": "npm run validate:lexicon && npm run test:stock && npm run test:shopping && npm run test:allergens && npm run test:cascade && npm run test:unified-input && npm run test:recipe-links && npm run test:unit-converter && npm run test:tags && npm run test:share && npm run test:pdf && npm run test:web-recipe && npm run test:search && npm run test:aisle && npm run test:helpers && npm run test:recipe-ai && npm run test:marmiton && npm run test:normalizer && npm run test:units && npm run test:shopping-parser",
    "lint": "expo lint",
    "test:aisle": "node scripts/testAisleClassifier.js",
    "test:helpers": "node scripts/testHelpers.js",
    "test:recipe-ai": "node scripts/testRecipeAiService.js",
    "test:marmiton": "node scripts/testMarmitonImages.js",
    "test:normalizer": "node scripts/testIngredientNormalizer.js",
    "test:units": "node scripts/testUnits.js",
    "test:shopping-parser": "node scripts/testShoppingInputParser.js"
  },
  "overrides": {
    "braces": "^3.0.3",
    "node-forge": "^1.4.0",
    "uuid": "^11.1.1"
  },
  "private": true
}
