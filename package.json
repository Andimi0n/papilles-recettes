{
  "name": "papilles-recettes",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I | awk '{print $1}') expo start --lan -c",
    "lan": "EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' || hostname -I | awk '{print $1}') expo start --lan",
    "tunnel": "EXPO_NO_TELEMETRY=1 expo start --tunnel",
    "lan:wifi": "EXPO_NO_TELEMETRY=1 REACT_NATIVE_PACKAGER_HOSTNAME=192.168.99.164 expo start --lan",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "import:marmiton": "node scripts/import_marmiton.js"
  },
  "overrides": {
    "braces": "^3.0.3",
    "node-forge": "^1.4.0",
    "uuid": "^11.1.1"
  },
  "private": true
}
